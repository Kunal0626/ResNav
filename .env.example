# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#     cp .env.example .env && chmod 600 .env
#
# ONE file configures the whole stack. run.sh reads it and exports every
# variable into the environment before starting anything, because the Flask
# settings layer reads os.environ directly and does not parse a .env file
# itself. (The original ResNav README told you to create backend/.env; nothing
# ever read it. run.sh is what makes this file actually take effect.)

# ── Database ─────────────────────────────────────────────────────────────────
# run.sh turns these into a chmod-600 temporary MySQL defaults file, so the
# password never appears on a command line, in `ps`, or in shell history.
DRA_MYSQL_USER=resnav_app
DRA_MYSQL_PASSWORD=change-me
DRA_MYSQL_HOST=127.0.0.1
DRA_MYSQL_PORT=3306
DRA_MYSQL_DB=resnav

# Absolute path to the mysql client, if it is not on your PATH. macOS .dmg:
# MYSQL_BIN=/usr/local/mysql/bin/mysql

# Docker only. The compose stack creates its own MySQL server inside the
# container, and needs a root password to initialise it. Ignored entirely by
# the local path, which connects to a server you already run.
DRA_MYSQL_ROOT_PASSWORD=change-me-too

# ── Backend (Flask) ──────────────────────────────────────────────────────────
# development | production
APP_ENV=development

# REQUIRED when APP_ENV=production; boot fails without it. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Comma-separated frontend origins the API will accept. Required in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Used server-side only to build the Maps embed URL for the results
# page. The key itself is never sent to the browser. Restrict it by HTTP
# referrer in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# Opt in to sentence-transformers ranking instead of TF-IDF. Needs
# requirements-ml.txt (~2.5 GB with torch), so it is off by default.
ENABLE_TRANSFORMERS=false

# Ranking tuning. GEO_SCALE_KM is the distance at which proximity decays to ~0.37.
GEO_SCALE_KM=10.0
MAX_RESULTS=15
LOG_LEVEL=INFO

# ── Frontend ─────────────────────────────────────────────────────────────────
# Leave empty for local development: the Vite dev server proxies /api to the
# backend, so both halves are same-origin and CORS never applies locally.
# In production set it to the deployed API origin, with no trailing slash.
#
# WARNING: anything prefixed VITE_ is compiled into the JavaScript bundle and
# is publicly readable. Never put a secret here.
VITE_API_BASE_URL=
