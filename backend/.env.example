# ── Backend configuration ────────────────────────────────────────────────────
# Copy to .env for local development. Never commit .env.

# development | production
APP_ENV=development

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# REQUIRED in production — comma-separated list of allowed frontend origins.
# Development defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Absolute path to the SQLite file. Defaults to backend/instance/.
# On a container platform this MUST point at a mounted persistent volume.
# DATABASE_PATH=/data/resource_navigator.db

# Optional: Google Maps Embed API key, used server-side for the route preview
# on the results page. The key is never sent to the browser. Restrict it by
# HTTP referrer in the Google Cloud console.
GOOGLE_MAPS_API_KEY=

# Opt in to transformer-backed semantic search. Requires requirements-ml.txt
# (~2.5 GB with torch). Leave false to use the TF-IDF encoder.
ENABLE_TRANSFORMERS=false

# Ranking tuning.
GEO_SCALE_KM=10.0
MAX_RESULTS=15

LOG_LEVEL=INFO
