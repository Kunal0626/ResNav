# ── Frontend configuration ───────────────────────────────────────────────────
# Copy to .env.local for local development. Vite only exposes VITE_* variables
# to the browser, so NEVER put a secret here — everything in this file ships in
# the JavaScript bundle and is publicly readable.

# Base URL of the ResNav API.
# Leave EMPTY in development: the Vite dev server proxies /api to the backend,
# which keeps everything same-origin and avoids CORS entirely.
# Set to the deployed backend origin in production, with no trailing slash.
VITE_API_BASE_URL=

# Optional: override the backend the dev proxy targets (default http://127.0.0.1:5001).
# VITE_DEV_API_PROXY=http://127.0.0.1:5001
