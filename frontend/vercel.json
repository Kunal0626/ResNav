{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "comment": "buildCommand is build:demo because nothing hosts the API yet, so this\n  deployment answers from the captured snapshot in public/demo. Point it back at\n  `npm run build` and set VITE_API_BASE_URL once a real backend exists.",
  "buildCommand": "npm run build:demo",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "comment": "Client-side routing: every path resolves to the SPA shell.",
      "source": "/((?!assets/|demo/|favicon.svg|robots.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
      ]
    }
  ]
}
