# ── Credentials ──────────────────────────────────────────────────────────────
# Never commit these. See .env.example for the shape.
.env
.env.*
!.env.example
*.cnf
*.my.cnf

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ── Databases ────────────────────────────────────────────────────────────────
# The schema and seed live in db/, so a database file is a build artefact.
# Rebuild it with `make reset`.
backend/instance/
instance/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# MySQL dumps can contain real data; export them outside the repo.
*.sql.gz
dump.sql

# ── Local scratch output from run.sh and the test runners ────────────────────
out/
*.log
*.err
# Captured test output that has not been reviewed and promoted to .expected
db/tests/**/*.actual
tests/**/*.actual

# ── Editors and OS ───────────────────────────────────────────────────────────
.DS_Store
._*
.idea/
.vscode/
*.swp

# ── Local tooling ────────────────────────────────────────────────────────────
# .claude/launch.json IS tracked: it is how the preview/dev-server tooling
# knows how to start this project. Everything else under .claude/ is personal.
.claude/*
!.claude/launch.json

# local editor / assistant config
.claude/

# Vercel CLI project link (ids are local, not source)
.vercel/
